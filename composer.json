{
    "name": "researcher86/php-mini-http-server",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PhpMiniHttpServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpMiniHttpServer\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-pcntl": "*",
        "ext-posix": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer check --diff"
    },
    "config": {
        "sort-packages": true
    }
}
